{
  "manifest_version": 3,
  "name": "OpenRelay for Reddit",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "Read Reddit pages with OpenRelay’s cards, themes, comment threads and media viewer.",
  "permissions": [
    "storage"
  ],
  "optional_permissions": [
    "downloads"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Toggle OpenRelay / original Reddit"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://reddit.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "reader.html",
        "assets/*"
      ],
      "matches": [
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://reddit.com/*"
      ]
    }
  ]
}
